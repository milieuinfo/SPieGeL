<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>be.vlaanderen.omgeving.spiegel</groupId>
    <artifactId>spiegel-parent</artifactId>
    <version>0.1.1-SNAPSHOT</version>
  </parent>

  <artifactId>spiegel-bootstrap</artifactId>
  <name>SPieGeL :: Bootstrap</name>
  <description>Spring Boot application: wiring, caching, health and packaging.</description>

  <dependencies>
    <dependency>
      <groupId>be.vlaanderen.omgeving.spiegel</groupId>
      <artifactId>spiegel-model</artifactId>
    </dependency>
    <dependency>
      <groupId>be.vlaanderen.omgeving.spiegel</groupId>
      <artifactId>spiegel-application</artifactId>
    </dependency>
    <dependency>
      <groupId>be.vlaanderen.omgeving.spiegel</groupId>
      <artifactId>spiegel-adapter-in-rest</artifactId>
    </dependency>
    <dependency>
      <groupId>be.vlaanderen.omgeving.spiegel</groupId>
      <artifactId>spiegel-adapter-out-virtuoso</artifactId>
    </dependency>
    <dependency>
      <groupId>be.vlaanderen.omgeving.spiegel</groupId>
      <artifactId>spiegel-adapter-out-elastic</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-actuator</artifactId>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>com.tngtech.archunit</groupId>
      <artifactId>archunit-junit5</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
      </plugin>
    </plugins>
  </build>
</project>
